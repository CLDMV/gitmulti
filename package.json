{
	"name": "gitmulti",
	"version": "0.1.1",
	"description": "Simple Node system to manage multiple Repositories into the same repo",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./types/index.d.mts",
	"bin": {
		"gitmulti": "./bin/gitmulti.mjs"
	},
	"exports": {
		".": {
			"gitmulti-dev": {
				"types": "./types/index.d.mts",
				"import": "./src/index.mjs",
				"require": "./src/index.cjs"
			},
			"types": "./types/index.d.mts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist/",
		"!dist/**/*.map",
		"types/",
		"bin/",
		"!bin/**/*.map"
	],
	"scripts": {
		"lint": "eslint --config .configs/eslint.config.mjs .",
		"lint:fix": "eslint --config .configs/eslint.config.mjs . --fix",
		"format": "prettier --config .configs/prettier.config.mjs --write .",
		"format:check": "prettier --config .configs/prettier.config.mjs --check .",
		"test": "node tests/run-vitest.mjs && npm run test:cjs",
		"test:cjs": "npm run build && node --conditions=gitmulti-dev --test tests/cjs/entry.test.cjs",
		"test:watch": "vitest --config .configs/vitest.config.mjs",
		"test:types": "tsc -p .configs/tsconfig.json --noEmit",
		"coverage": "node tests/run-vitest.mjs --coverage-quiet && npm run test:cjs",
		"ci:coverage": "npm run coverage",
		"types:build": "tsc -p .configs/tsconfig.json",
		"build": "tsup",
		"build:ci": "npm run lint && npm run format:check && npm run types:build && npm run build",
		"prepack": "npm run types:build && npm run build",
		"fix:headers": "fix-headers --config .configs/fix-headers.json",
		"prepare": "node -e \"import('./.githooks/install.mjs').catch(()=>{})\""
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CLDMV/gitmulti.git"
	},
	"keywords": [
		"git",
		"repo",
		"multiple",
		"repos",
		"multiple"
	],
	"author": "Shinrai <git@cldmv.net> (http://cldmv.net)",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=22.22.0",
			"onFail": "error"
		}
	},
	"bugs": {
		"url": "https://github.com/CLDMV/gitmulti/issues"
	},
	"homepage": "https://github.com/CLDMV/gitmulti#readme",
	"dependencies": {
		"commander": "^15.0.0"
	},
	"devDependencies": {
		"@cldmv/configs": "^1.4.0",
		"@cldmv/fix-headers": "^2.2.6",
		"@cldmv/prettier-plugin-jsonv": "^1.2.1",
		"@cldmv/vitest-runner": "^1.6.1",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.0",
		"eslint": "^10.14.0",
		"prettier": "^3.9.10",
		"tsup": "^9.0.0",
		"typescript": "^6.0.3",
		"vitest": "^5.1.0"
	},
	"overrides": {
		"katex": ">=0.19.1 <1.0.0",
		"minimatch": "^11.0.3"
	}
}
