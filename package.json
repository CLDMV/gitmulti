{
  "name": "gitmulti",
  "version": "0.0.12",
  "description": "Simple Node system to manage multiple Repositories into the same repo",
  "main": "gitmulti.js",
  "scripts": {
    "test": "node tests/run-vitest.mjs",
    "build": "echo '✓ no build step (stopgap: the CI coverage-badge job runs `npm run build`)'",
    "build:ci": "echo '✓ no build step'",
    "test:watch": "vitest --config .configs/vitest.config.mjs",
    "coverage": "node tests/run-vitest.mjs --coverage-quiet",
    "ci:coverage": "npm run coverage",
    "fix:headers": "fix-headers --config .configs/fix-headers.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CLDMV/gitmulti.git"
  },
  "keywords": [
    "git",
    "repo",
    "multiple",
    "repos",
    "multiple"
  ],
  "author": "Shinrai <git@cldmv.net> (http://cldmv.net)",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/CLDMV/gitmulti/issues"
  },
  "homepage": "https://github.com/CLDMV/gitmulti#readme",
  "dependencies": {
    "commander": "^2.19.0"
  },
  "devDependencies": {
    "@cldmv/configs": "^1.2.4",
    "@cldmv/fix-headers": "^2.2.1",
    "@cldmv/vitest-runner": "^1.5.4",
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.1"
  }
}
